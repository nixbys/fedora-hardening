# Multi-stage Fedora hardening test container - optimized for minimal size and resource usage
# Build: podman build -f Dockerfile.test --target base -t fedora-harden:test .
# Run:   ./test-in-podman.sh --dry-run          (systemd variant)
#        ./test-in-podman.sh --quick --dry-run  (no-systemd variant)
#
# Version pinning (hadolint DL3041) is intentionally not used: these images track the
# current Fedora 44 package set so the script is tested against what users will install.
# hadolint global ignore=DL3041

# Fedora release under test (44, 45, ...). Every stage is built on that release.
ARG FEDORA_VERSION=44
ARG FEDORA_IMAGE=registry.fedoraproject.org/fedora-minimal:${FEDORA_VERSION}
ARG FEDORA_FULL_IMAGE=registry.fedoraproject.org/fedora:${FEDORA_VERSION}

# ============================================================================
# Full variant: systemd as PID 1 for realistic service/unit testing
# ============================================================================
FROM ${FEDORA_IMAGE} AS base
LABEL description="Fedora hardening script testing container - minimal footprint"
LABEL maintainer="fedora-hardening-project"

# fedora-minimal already sets tsflags=nodocs; weak deps are disabled per-transaction.
RUN set -e && \
    dnf install -y --setopt=install_weak_deps=False \
        bash \
        coreutils \
        findutils \
        grep \
        sed \
        gawk \
        systemd \
        sudo \
        curl \
        wget \
        git \
        diffutils \
        shadow-utils \
        util-linux \
        openssl \
        rpm \
        dnf5 \
        firewalld \
        selinux-policy \
        audit \
        aide \
        rkhunter \
        openssh-server \
        openssh-clients \
        cronie \
        flatpak \
        fail2ban \
        usbguard \
        policycoreutils \
        psmisc \
        which \
        file \
        procps-ng \
        iproute \
        less \
        && \
    dnf clean all && \
    rm -rf /var/cache/dnf/* /var/cache/libdnf5/* && \
    useradd -m -s /bin/bash testuser && \
    mkdir -p /var/log/fedora-harden /root/harden-backups

WORKDIR /root
ENV PATH="/root:${PATH}"

# Baked-in copy of the script (the test harness bind-mounts the working-tree copy over it)
COPY --chown=root:root fedora-harden.sh /root/fedora-harden.sh
RUN chmod 755 /root/fedora-harden.sh && bash -n /root/fedora-harden.sh

STOPSIGNAL SIGRTMIN+3
ENTRYPOINT ["/usr/sbin/init"]

# ============================================================================
# Minimal non-systemd variant for testing just the script logic (faster startup)
# Build: podman build --target test-only -f Dockerfile.test -t fedora-harden:test-only .
# ============================================================================
FROM ${FEDORA_IMAGE} AS test-only
LABEL description="Fedora hardening script logic testing - ultra-minimal, no systemd"

RUN set -e && \
    dnf install -y --setopt=install_weak_deps=False \
        bash \
        coreutils \
        findutils \
        grep \
        sed \
        gawk \
        sudo \
        curl \
        wget \
        git \
        shadow-utils \
        util-linux \
        openssl \
        rpm \
        dnf5 \
        which \
        procps-ng \
        less \
        && \
    dnf clean all && \
    rm -rf /var/cache/dnf/* /var/cache/libdnf5/* && \
    useradd -m -s /bin/bash testuser && \
    mkdir -p /var/log/fedora-harden

WORKDIR /root
ENV PATH="/root:${PATH}"

COPY --chown=root:root fedora-harden.sh /root/fedora-harden.sh
RUN chmod 755 /root/fedora-harden.sh && bash -n /root/fedora-harden.sh

ENTRYPOINT ["/bin/bash"]

# ============================================================================
# Lint/toolchain variant: the static test tier runs here so linters come from
# Fedora 44 RPMs (same versions setup-dev.sh installs and CI uses).
# Build: podman build --target lint -f Dockerfile.test -t fedora-harden:lint .
# ============================================================================
FROM ${FEDORA_FULL_IMAGE} AS lint
LABEL description="Fedora 44 lint toolchain for fedora-harden.sh"

RUN set -e && \
    dnf install -y --setopt=install_weak_deps=False \
        bash \
        git \
        findutils \
        diffutils \
        ShellCheck \
        yamllint \
        ruff \
        hadolint \
        python3 \
        python3-mcp \
        && \
    dnf clean all && \
    rm -rf /var/cache/dnf/* /var/cache/libdnf5/*

# shfmt: Fedora RPM where packaged (44), else the same pinned version built with
# Fedora's Go (45+). See tests/install-shfmt.sh.
COPY tests/install-shfmt.sh /usr/local/sbin/install-shfmt.sh
RUN /usr/local/sbin/install-shfmt.sh /usr/local/bin && \
    dnf clean all && \
    rm -rf /var/cache/dnf/* /var/cache/libdnf5/* /tmp/shfmt-gopath

WORKDIR /src
ENTRYPOINT ["/bin/bash"]

# ============================================================================
# GUI variant: virtual X display + both dialog toolkits the script supports
# (zenity for GTK, kdialog + qdbus for KDE) and tools to inspect/drive windows.
# Build: podman build --target gui -f Dockerfile.test -t fedora-harden:gui .
# ============================================================================
FROM ${FEDORA_FULL_IMAGE} AS gui
LABEL description="Fedora 44 GUI test bed for fedora-harden.sh --gui/--gui-full"

RUN set -e && \
    dnf install -y --setopt=install_weak_deps=False \
        bash \
        sudo \
        procps-ng \
        findutils \
        xorg-x11-server-Xvfb \
        xdotool \
        ImageMagick \
        dbus-daemon \
        dbus-tools \
        zenity \
        kdialog \
        qt6-qttools \
        plasma-integration \
        adwaita-icon-theme \
        dejavu-sans-fonts \
        mesa-libGLES \
        mesa-libEGL \
        mesa-dri-drivers \
        && \
    dnf clean all && \
    rm -rf /var/cache/dnf/* /var/cache/libdnf5/* && \
    useradd -m testuser && \
    systemd-machine-id-setup

WORKDIR /root
ENTRYPOINT ["/bin/bash"]
