# EditorConfig — also read by shfmt when it is run without style flags
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# The hardening script and its parts: tab-indented (shfmt defaults)
[{fedora-harden.sh,core/*.sh,fedora/lib/*.sh,fedora/sections/*.sh}]
indent_style = tab

# The routine helper installed by section 19: 4-space indent
[libexec/fedora-harden-routine]
indent_style = space
indent_size = 4

# Helper scripts: 4-space indent, indented case branches
[{setup-dev.sh,test-in-podman.sh,tests/*.sh}]
indent_style = space
indent_size = 4
switch_case_indent = true

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
